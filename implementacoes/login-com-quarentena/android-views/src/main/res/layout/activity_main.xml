<?xml version="1.0" encoding="utf-8" ?>
<!-- A página: o botão que tira o painel da página e o põe de volta. O painel
     fica em painel.xml, e a aparência, em res/values/estilo.xml, como o
     estilo.css. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Pagina">
    <LinearLayout
        android:id="@+id/login"
        style="@style/Login">
        <Button
            android:id="@+id/alternar"
            style="@style/Botao"
            android:text="Esconder login" />
    </LinearLayout>
</FrameLayout>
