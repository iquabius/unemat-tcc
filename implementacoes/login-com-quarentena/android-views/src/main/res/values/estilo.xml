<?xml version="1.0" encoding="utf-8" ?>
<!-- Aparência do Login com quarentena, no papel do estilo.css da web: o layout
     só cita os estilos pelo nome (style="@style/..."), como o class do HTML.
     O botão desabilitado fica nos seletores de res/color/, como o :disabled
     que o navegador pinta. -->
<resources>
    <color name="fundo">#2b2b2b</color>

    <!-- body: o tema da tela inteira, aplicado no AndroidManifest.xml. -->
    <style
        name="Tema"
        parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
    </style>

    <style name="Pagina">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- .login: uma coluna com 0.75rem entre os itens e 1rem de margem. O
         LinearLayout não tem max-width (20rem na web); a largura fixa dá a
         coluna de 320dp, como na captura, numa tela mais larga que ela. -->
    <style name="Login">
        <item name="android:layout_width">352dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:divider">@drawable/espaco_de_12dp</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- .painel: uma coluna com 0.75rem entre os itens. -->
    <style name="Painel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:divider">@drawable/espaco_de_12dp</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- .painel label: o texto e o campo, com 0.25rem entre eles. -->
    <style
        name="Rotulo"
        parent="Painel">
        <item name="android:divider">@drawable/espaco_de_4dp</item>
    </style>

    <!-- Texto comum (a cor e o tamanho do body), sem o espaço que a TextView
         põe acima e abaixo da fonte, que o navegador e o Compose não põem. -->
    <style name="Texto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#eeeeee</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- .painel input: fundo e borda em drawable/entrada.xml. -->
    <style
        name="Entrada"
        parent="Texto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/entrada</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:padding">6.4dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- .login button: o botão padrão do navegador, cinza-claro, com borda e
         cantos de 3px, e 0.4rem de margem interna, esticado na coluna, com
         :disabled nas cores (color/fundo_do_botao.xml,
         color/texto_do_botao.xml e color/borda_do_botao.xml). Sem as margens
         externas, os tamanhos mínimos, o espaço acima e abaixo da fonte e o
         texto em negrito do botão do Material. -->
    <style
        name="Botao"
        parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/texto_do_botao</item>
        <item name="backgroundTint">@color/fundo_do_botao</item>
        <item name="strokeColor">@color/borda_do_botao</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">6.4dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
