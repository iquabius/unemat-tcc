<?xml version="1.0" encoding="utf-8" ?>
<!-- O painel, que a MainActivity põe na página e tira dela, como o
     <section class="painel"> do Web Component. As linhas dos jogos ficam em
     linha.xml. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/painel"
    style="@style/Painel">
    <!-- Como o role="status": o leitor de tela anuncia a atualização. -->
    <TextView
        android:id="@+id/situacao"
        style="@style/Situacao"
        android:accessibilityLiveRegion="polite" />

    <TextView
        android:id="@+id/atualizacao"
        style="@style/Atualizacao" />

    <TableLayout
        android:id="@+id/tabela"
        style="@style/Tabela">
        <TableRow style="@style/Linha">
            <TextView
                style="@style/PrimeiroCabecalho"
                android:text="Jogo" />

            <TextView
                style="@style/Cabecalho"
                android:text="Placar" />

            <TextView
                style="@style/Cabecalho"
                android:text="Tempo" />

            <TextView
                style="@style/Cabecalho"
                android:text="Gols novos" />

            <TextView
                style="@style/Cabecalho"
                android:text="Palpite" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/pausa"
        style="@style/Botao"
        android:text="Pausar" />
</LinearLayout>
