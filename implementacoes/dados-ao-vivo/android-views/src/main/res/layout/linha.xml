<?xml version="1.0" encoding="utf-8" ?>
<!-- A linha de um jogo, que a MainActivity cria uma vez por jogo, como o
     createElement("tr") do Web Component. A Celula (Celula.kt) é a TextView
     que fica em negrito na linha ativada. -->
<TableRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Linha">
    <tcc.dadosaovivo.views.Celula
        android:id="@+id/codigo"
        style="@style/PrimeiraCelula" />

    <tcc.dadosaovivo.views.Celula
        android:id="@+id/placar"
        style="@style/Celula" />

    <tcc.dadosaovivo.views.Celula
        android:id="@+id/tempo"
        style="@style/Celula" />

    <tcc.dadosaovivo.views.Celula
        android:id="@+id/gols_novos"
        style="@style/Celula" />

    <tcc.dadosaovivo.views.Celula
        android:id="@+id/palpite"
        style="@style/Celula" />
</TableRow>
