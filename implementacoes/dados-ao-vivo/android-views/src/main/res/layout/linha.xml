<?xml version="1.0" encoding="utf-8" ?>
<!-- A linha de um jogo, que a MainActivity cria uma vez por jogo, como o
     createElement("tr") do Web Component. -->
<TableRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Linha">
    <TextView
        android:id="@+id/codigo"
        style="@style/PrimeiraCelula" />

    <TextView
        android:id="@+id/placar"
        style="@style/Celula" />

    <TextView
        android:id="@+id/tempo"
        style="@style/Celula" />

    <TextView
        android:id="@+id/gols_novos"
        style="@style/Celula" />

    <TextView
        android:id="@+id/palpite"
        style="@style/Celula" />
</TableRow>
