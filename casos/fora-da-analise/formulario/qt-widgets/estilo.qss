/* Aparência do Formulário, que reproduz o estilo.css do caso: o QSS seleciona
   por tipo e por propriedade, como o CSS por elemento e por atributo. */
/* O tamanho da janela é o da QML; o QSS não herda o font-size do pai. */
Janela {
  min-width: 416px;
  min-height: 560px;
  background: #2b2b2b;
}

QLabel {
  color: #eee;
  font-size: 16px;
}

QLineEdit,
QComboBox {
  padding: 6px;
  border: 1px solid #555;
  background: #3a3a3a;
  color: #eee;
  font-size: 16px;
}

QLineEdit:disabled {
  color: rgba(238, 238, 238, 0.5);
  border-color: rgba(85, 85, 85, 0.5);
  background: rgba(58, 58, 58, 0.5);
}

QLineEdit[invalido="true"] {
  border-color: #e05555;
  background: #4a2a2a;
}

QLabel[papel="erro"] {
  color: #ff8a8a;
  font-size: 14px;
  qproperty-wordWrap: true;
}

QPushButton {
  padding: 8px;
  border: 1px solid #555;
  background: #2e4d24;
  color: #eee;
  font-size: 16px;
}

QPushButton:disabled {
  background: #3a3a3a;
  color: #888;
}

#formulario {
  min-width: 416px;
  max-width: 416px;
}

QLabel[papel="confirmacao"] {
  margin: 0 16px;
  max-width: 384px;
  color: #9fd88a;
  qproperty-wordWrap: true;
}
