/* Aparência da Lista, que reproduz o estilo.css do caso: o QSS seleciona por
   tipo e por propriedade, como o CSS por elemento e por classe. */
/* O tamanho da janela é o da QML; o QSS não herda o font-size do pai. */
Janela {
  min-width: 480px;
  min-height: 640px;
  background: #2b2b2b;
}

QLabel {
  color: #eee;
  font-size: 16px;
}

QLineEdit,
QComboBox {
  padding: 6px;
  border: 1px solid #555;
  background: #3a3a3a;
  color: #eee;
  font-size: 16px;
}

QLabel[papel="contagem"],
QLabel[papel="vazio"] {
  color: #aaa;
}

QListWidget {
  border: none;
  background: #444;
}

QListWidget::item {
  margin-bottom: 1px;
  background: #333;
}

QLabel[papel="categoria"] {
  color: #999;
  font-size: 14px;
}

QLabel[papel="preco"] {
  color: #9fd88a;
}
