<?xml version="1.0" encoding="UTF-8"?>
<!-- A estrutura da tela, como o index.html do jQuery e o layout XML do Views.
     A aparência fica em estilo.qss, como o estilo.css; só o espaçamento
     entre os elementos fica aqui, porque o QSS não alcança os layouts. -->
<ui version="4.0">
 <class>Janela</class>
 <widget class="QWidget" name="Janela">
  <property name="windowTitle">
   <string>Formulário com validação</string>
  </property>
  <layout class="QVBoxLayout" name="pagina">
   <property name="spacing">
    <number>0</number>
   </property>
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QWidget" name="formulario">
     <layout class="QVBoxLayout" name="campos">
      <property name="spacing">
       <number>12</number>
      </property>
      <property name="leftMargin">
       <number>16</number>
      </property>
      <property name="topMargin">
       <number>16</number>
      </property>
      <property name="rightMargin">
       <number>16</number>
      </property>
      <property name="bottomMargin">
       <number>16</number>
      </property>
      <!-- Como o <label>: o texto e o campo que ele nomeia (buddy). -->
      <item>
       <layout class="QVBoxLayout" name="rotuloNome">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QLabel" name="textoNome">
          <property name="text">
           <string>Nome do passageiro</string>
          </property>
          <property name="buddy">
           <cstring>nome</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="nome"/>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="erroNome">
        <property name="papel" stdset="0">
         <string>erro</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QVBoxLayout" name="rotuloEmail">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QLabel" name="textoEmail">
          <property name="text">
           <string>E-mail</string>
          </property>
          <property name="buddy">
           <cstring>email</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="email">
          <property name="inputMethodHints">
           <set>Qt::InputMethodHint::ImhEmailCharactersOnly</set>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="erroEmail">
        <property name="papel" stdset="0">
         <string>erro</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QVBoxLayout" name="rotuloTipo">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QLabel" name="textoTipo">
          <property name="text">
           <string>Tipo de voo</string>
          </property>
          <property name="buddy">
           <cstring>tipo</cstring>
          </property>
         </widget>
        </item>
        <item>
         <!-- Como o <select>: a ordem das opções é a do enum TipoDeVoo. -->
         <widget class="QComboBox" name="tipo">
          <item>
           <property name="text">
            <string>Só ida</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Ida e volta</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="rotuloIda">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QLabel" name="textoIda">
          <property name="text">
           <string>Data de ida</string>
          </property>
          <property name="buddy">
           <cstring>ida</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="ida">
          <property name="placeholderText">
           <string>DD/MM/AAAA</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="erroIda">
        <property name="papel" stdset="0">
         <string>erro</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QVBoxLayout" name="rotuloVolta">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QLabel" name="textoVolta">
          <property name="text">
           <string>Data de volta</string>
          </property>
          <property name="buddy">
           <cstring>volta</cstring>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLineEdit" name="volta">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="placeholderText">
           <string>DD/MM/AAAA</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="erroVolta">
        <property name="papel" stdset="0">
         <string>erro</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="reservar">
        <property name="text">
         <string>Reservar</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="confirmacao">
     <property name="papel" stdset="0">
      <string>confirmacao</string>
     </property>
    </widget>
   </item>
   <item>
    <!-- O resto da altura fica vazio, embaixo, como na página. -->
    <spacer name="resto">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
