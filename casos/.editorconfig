# Formatação de casos/ (tcc-6wha). O Prettier (web e XML do Android), o
# ktfmt (Kotlin) e o CSharpier (C# e XAML) leem a largura daqui: 80
# colunas em todas as plataformas, para o código caber no PDF. O resto fica
# no padrão de cada ferramenta, salvo o XML do Android, abaixo e no
# .prettierrc.json.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 80

# Recuo do Android Studio nos layouts e recursos.
[*.xml]
indent_style = space
indent_size = 4
