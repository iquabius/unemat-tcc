\setminted{
  frame=single,
  framesep=2mm,
  %baselinestretch=1.2,
  fontsize=\footnotesize, % scriptsize, footnotesize, small
  linenos,
  xleftmargin=1.5em, % os números de linha dentro da mancha, fora da margem
