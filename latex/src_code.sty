\usepackage[newfloat]{minted}

% A fonte monoespaçada do documento, no lugar da Courier estreitada do
% pslatex, de traço fino: a DejaVu Sans Mono, base da Menlo, padrão do VS
% Code no macOS. Na escala de 0.86, 80 colunas cabem no quadro.
\usepackage[scaled=0.86]{DejaVuSansMono}

% Um estilo só, para todas as linguagens: o GitHub Light de alto contraste,
% em que toda cor passa de 4,5:1 contra o branco (WCAG 2.2, 1.4.3). Vem do
% pacote pygments-styles, que o Python do latexminted precisa enxergar; sem
% ele, o minted para com "Pygments style ... was not found".
\usemintedstyle{github-light-high-contrast}

%\renewcommand{\theFancyVerbLine}{\sffamily
%  \textcolor[rgb]{0.5,0.5,1.0}{\tiny
%    \oldstylenums{\arabic{FancyVerbLine}}}}

\setminted{
  frame=single,
  framesep=2mm,
  %baselinestretch=1.2,
  fontsize=\footnotesize, % scriptsize, footnotesize, small
  linenos,
  xleftmargin=1.5em, % os números de linha dentro da mancha, fora da margem
  mathescape,
}

% Código no meio do texto em preto (NBR 14724, 5.1); as cores ficam nos
% códigos numerados, que são ilustrações.
\setmintedinline{
  fontsize=\normalsize,
  style=bw,
}

\SetupFloatingEnvironment{listing}{
  name=Código,
  listname=Lista de Códigos de Programas,
  within=none}
