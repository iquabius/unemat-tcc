#!/usr/bin/env bash
# tarefas — abre o Bead Me Up, Scotty no quadro deste repositório, com o
# envio de uso ao PostHog desligado. O Scotty fica fora do repositório, em
# ~/.local/share/bead-me-up-scotty (ou em $SCOTTY_HOME).
cd "$(git rev-parse --show-toplevel)"
POSTHOG_KEY= exec node "${SCOTTY_HOME:-$HOME/.local/share/bead-me-up-scotty}/bin/bead-me-up-scotty.mjs" "$@"
